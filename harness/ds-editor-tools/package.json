{
  "name": "@demostudio/ds-editor-tools",
  "version": "0.1.0",
  "description": "DemoStudio 编辑器 UI 操控工具集：通过 Playwright CDP 连接编辑器实例，提供 UI 点击/输入/截图/状态读取等能力；同时通过 editor.* AI 事件操作面板/视口/工程。",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "keywords": [
    "demostudio",
    "dsh",
    "editor",
    "ui",
    "playwright",
    "cdp"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "playwright-core": "^1.62.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
