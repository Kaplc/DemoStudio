{
  "name": "@demostudio/ds-reminder",
  "version": "0.1.0",
  "description": "DSH 回合末通用提醒插件：把回合边界注入提醒的机制（通道投递 + 本回合已保存跳过判定 + 冷却 + 子 agent 门控）从业务插件收敛为一处，配置声明 N 条提醒（文本/通道/skipTools/冷却），默认内置从 ds-memory/ds-experience 平移的记忆与经验两条提醒。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run"
  },
  "keywords": [
    "demostudio",
    "dsh",
    "reminder",
    "agent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
