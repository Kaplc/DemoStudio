{
  "name": "@demostudio/ds-engine-tools",
  "version": "0.1.0",
  "description": "DemoStudio 引擎特化工具集：DSH 原生工具（inspect_scene/spawn_entity/run_scenario/get_game_state/set_game_speed），通过 ctx.tools.register 注册；仅依赖 EngineBridge，不依赖 DSH 内部 API。",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests"
  },
  "keywords": [
    "demostudio",
    "dsh",
    "agent",
    "tools"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
