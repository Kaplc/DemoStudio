{
  "name": "@demostudio/ds-memory",
  "version": "0.1.0",
  "description": "DSH 记忆系统插件：跨会话持久记忆（.dsh/memory/ Markdown 文件 + MEMORY.md 索引），提供 memory_write/search/forget/review 四工具、system prompt 记忆指导、回合末自动提取提醒与 AI 选择检索注入。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run"
  },
  "keywords": [
    "demostudio",
    "dsh",
    "memory",
    "agent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
