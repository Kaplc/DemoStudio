{
  "name": "@demostudio/ds-experience",
  "version": "0.1.0",
  "description": "DSH 行为飞轮插件：做事轨迹经验库（.dsh/experience/ episode + INDEX.md）与历史会话检索（history_search/history_read 包装 ctx.sessionQuery），回合末保存提醒 + frontmatter prefix 路径联想自动注入（读匹配文件即整篇注入、每会话去重），经验保存由主 agent 自觉调用 experience_save。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run"
  },
  "keywords": [
    "demostudio",
    "dsh",
    "experience",
    "history",
    "agent"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
