{
    "$schema": "1.0",
    "metadata": {
        "name": "DemoStudio Editor",
        "description": "DemoStudio 编辑器主界面 (精简版)",
        "version": "4.0.0",
        "author": "DemoStudio"
    },
    "variables": {},
    "ui": {
        "type": "UIWidget",
        "id": "editor_root",
        "anchor": "CENTER",
        "size": ["$aspect", 1.0],
        "color": "$background",
        "alpha": 0.0,
        "z": 0.0,
        "children": [
            {
                "type": "UIButton",
                "id": "main_btn",
                "anchor": "CENTER",
                "offset": [0, 0],
                "size": [0.2, 0.06],
                "color": "$accent",
                "z": 0.001,
                "children": [
                    {
                        "type": "UIText",
                        "id": "main_btn_text",
                        "text": "Hello DemoStudio",
                        "anchor": "CENTER",
                        "offset": [0, 0],
                        "font_size": 0.64,
                        "color": "$text",
                        "z": 0.002
                    }
                ]
            }
        ]
    },
    "bindings": {}
}
